# Virtual environments
.venv/
venv/
env/

# Python bytecode and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Environment variables
.env
.env.*
!.env.example
*.env

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# IDE / editor workspace files
.vscode/
.idea/
*.code-workspace
*.sublime-project
*.sublime-workspace

# Data (keep folder structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*~
*.log

# Windows artifacts
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS artifacts
.DS_Store
